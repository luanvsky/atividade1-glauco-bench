{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar LaTeX e Abrir PDF",
            "type": "shell",
            "command": "pdflatex",
            "args": [
                "-interaction=nonstopmode",
                "document.tex"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "runOptions": {
                "runOn": "default"
            }
        },
        {
            "label": "Compilar e Abrir PDF",
            "type": "shell",
            "command": "pdflatex -interaction=nonstopmode document.tex && code document.pdf",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
